*.log
.DS_Store
# SECRETS — never commit real environment files: .env holds APP_KEY,
# DB credentials, API keys. `.env.*` catches .env.local/.env.staging/...
# (files a future teammate might create), while the explicit negation
# keeps the safe TEMPLATE tracked so fresh clones can copy it.
.env
.env.*
!.env.example
.env.backup
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
